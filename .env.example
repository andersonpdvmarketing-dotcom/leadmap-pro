# =====================================================================
# LeadMap Pro — variáveis de ambiente (backend)
# ---------------------------------------------------------------------
# Ficheiro de EXEMPLO. Não contém segredos reais e não deve conter.
# Copiar para .env.local (ignorado pelo git) ou definir na Vercel.
#
# Nenhuma destas variáveis chega ao browser: são lidas apenas dentro de
# funções serverless em api/.
# Todas estas variáveis aparecem, por NOME, em Configurações → Integrações
# dentro da aplicação. O valor nunca é mostrado nem sai do backend.
# =====================================================================

# --- Pesquisa (já existente) -----------------------------------------
GOOGLE_PLACES_API_KEY=
# Geocodificação de moradas.
GOOGLE_MAPS_API_KEY=

# --- Outreach: base de dados -----------------------------------------
# PostgreSQL acedido por HTTP (PostgREST/Supabase). Aplicar primeiro as
# migrations em migrations/*.sql pela ordem numérica.
OUTREACH_DB_URL=
OUTREACH_DB_SERVICE_KEY=
OUTREACH_DB_SCHEMA=outreach

# Alternativa aceite para as duas primeiras, se preferir os nomes do
# Supabase. Prefira OUTREACH_DB_* — dizem para que servem e não colidem
# com convenções de frameworks que expõem SUPABASE_* ao browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Outreach: autenticação do operador ------------------------------
# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios).
OUTREACH_AUTH_SECRET=
# Email do operador autorizado.
OUTREACH_OPERATOR_EMAIL=
# Hash scrypt da password: scrypt$<salt-hex>$<derivado-hex>.
# Gerar com:  node tools/hash-password.mjs
# NUNCA guardar a password em claro.
OUTREACH_OPERATOR_PASSWORD_HASH=

# --- Outreach: worker ------------------------------------------------
# Segredo próprio do endpoint do worker; não é a sessão do operador.
OUTREACH_WORKER_SECRET=

# --- Ambiente --------------------------------------------------------
# development | test | production
# Fora de development/test o fornecedor de teste é recusado: em produção
# o sistema não simula envios.
OUTREACH_ENV=development

# --- Ferramentas administrativas (NUNCA na Vercel) -------------------
# DSN direta de PostgreSQL, usada apenas por tools/apply-migrations.mjs
# e tools/check-schema.mjs, a partir da máquina de quem administra.
# Se isto existisse no ambiente do runtime, a função serverless passava a
# ter um caminho para executar DDL — que é exatamente o que se impede.
# OUTREACH_ADMIN_DATABASE_URL=

# DSN da suite de testes de integração. Também nunca vai para a Vercel.
# OUTREACH_TEST_DATABASE_URL=

# --- ManyChat (fornecedor real de envio) -----------------------------
# Token da ManyChat, formato `<pageId>:<segredo>`.
# Obter em app.manychat.com → Settings → API.
# Vive SÓ no backend: nunca no index.html, localStorage, IndexedDB ou logs.
MANYCHAT_API_TOKEN=

# --- Meta: Instagram API with Instagram Login ------------------------
# Caminho oficial, host graph.instagram.com. Ver docs/instagram-providers.md.
#
# Token de acesso da conta profissional. Scopes exigidos pela
# documentação: instagram_business_basic + instagram_business_manage_messages
INSTAGRAM_META_ACCESS_TOKEN=

# App Secret — usado APENAS para validar a assinatura X-Hub-Signature-256
# dos webhooks. Sem ele, qualquer um que descubra o URL pode injetar
# "mensagens recebidas" e abrir janelas de resposta que nunca existiram.
INSTAGRAM_META_APP_SECRET=

# Verify token do handshake de subscrição do webhook (valor à sua escolha).
INSTAGRAM_META_VERIFY_TOKEN=

# Versão da API (opcional; por omissão v25.0).
INSTAGRAM_META_GRAPH_VERSION=

# Levanta o bloqueio de ENVIO. Só definir "1" depois de o teste de ligação
# passar a CONNECTION_VALIDATED. Ter token não chega.
INSTAGRAM_META_ENABLED_FOR_REAL_REQUESTS=

# Fornecedor externo: nenhum escolhido nesta fase.
INSTAGRAM_EXTERNAL_PROVIDER=
INSTAGRAM_EXTERNAL_BASE_URL=
INSTAGRAM_EXTERNAL_API_KEY=
