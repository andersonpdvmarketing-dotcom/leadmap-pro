# =====================================================================
# LeadMap Pro — variáveis de ambiente (backend)
# ---------------------------------------------------------------------
# Ficheiro de EXEMPLO. Não contém segredos reais e não deve conter.
# Copiar para .env.local (ignorado pelo git) ou definir na Vercel.
#
# Nenhuma destas variáveis chega ao browser: são lidas apenas dentro de
# funções serverless em api/.
# =====================================================================

# --- Pesquisa (já existente) -----------------------------------------
GOOGLE_PLACES_API_KEY=

# --- Outreach: base de dados -----------------------------------------
# PostgreSQL acedido por HTTP (PostgREST/Supabase). Aplicar primeiro as
# migrations em migrations/*.sql pela ordem numérica.
OUTREACH_DB_URL=
OUTREACH_DB_SERVICE_KEY=
OUTREACH_DB_SCHEMA=outreach

# --- Outreach: autenticação do operador ------------------------------
# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios).
OUTREACH_AUTH_SECRET=
# Email do operador autorizado.
OUTREACH_OPERATOR_EMAIL=
# Hash scrypt da password: scrypt$<salt-hex>$<derivado-hex>.
# Gerar com criarHashPassword() de providers/outreach/auth.mjs.
# NUNCA guardar a password em claro.
OUTREACH_OPERATOR_PASSWORD_HASH=

# --- Outreach: worker ------------------------------------------------
# Segredo próprio do endpoint do worker; não é a sessão do operador.
OUTREACH_WORKER_SECRET=

# --- Ambiente --------------------------------------------------------
# development | test | production
# Fora de development/test o fornecedor de teste é recusado: em produção
# o sistema não simula envios.
OUTREACH_ENV=development

# --- Instagram: bloqueado nesta fase ---------------------------------
# O adapter da Meta está desligado por omissão. Só definir "1" DEPOIS de
# validar os endpoints da Graph API (ver INSTAGRAM_PROVIDERS.md §2).
INSTAGRAM_META_ENABLED_FOR_REAL_REQUESTS=
INSTAGRAM_META_ACCESS_TOKEN=
INSTAGRAM_META_APP_SECRET=
INSTAGRAM_META_VERIFY_TOKEN=

# Fornecedor externo: nenhum escolhido nesta fase.
INSTAGRAM_EXTERNAL_PROVIDER=
INSTAGRAM_EXTERNAL_BASE_URL=
INSTAGRAM_EXTERNAL_API_KEY=
